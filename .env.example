# Daytona — https://app.daytona.io → API Keys
DAYTONA_API_KEY=dtn_...
# DAYTONA_API_URL=https://app.daytona.io/api

# Anthropic — or run `ant auth login` and leave unset
ANTHROPIC_API_KEY=sk-ant-...
